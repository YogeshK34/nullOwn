# Demo-mode configuration. Copy to .env.local, or run `npm run demo` from the
# repository root, which copies it for you and starts the dev server.
#
# Demo mode runs the whole app with no chain behind it. Contract addresses,
# block numbers, transaction hashes, the audit log, role assignments and the
# Groth16 proof bytes are fabricated in frontend/lib/demo.ts, and a mock wallet
# connects on load.
#
# Everything cryptographic stays real: stealth keys, ECDH derivation, the
# Poseidon Merkle tree and the nullifier all run the same code they would
# against Sepolia. A revealed stealth key genuinely controls the address it is
# shown against.
#
# This file contains no secrets and is committed on purpose.

NEXT_PUBLIC_DEMO_MODE=true

# Sepolia, so chain names and explorer links read as they would in reality.
NEXT_PUBLIC_CHAIN_ID=11155111

# Every NEXT_PUBLIC_* below is intentionally unset. In demo mode each falls back
# to a synthetic value; setting one here overrides the demo value, so a partial
# real deployment can be mixed in.
#
# NEXT_PUBLIC_ERC5564_ADDRESS=
# NEXT_PUBLIC_ERC6538_ADDRESS=
# NEXT_PUBLIC_VERIFIER_ADDRESS=
# NEXT_PUBLIC_COMPLIANCE_ADDRESS=
# NEXT_PUBLIC_ANNOUNCEMENT_START_BLOCK=
# NEXT_PUBLIC_RPC_URL=
#
# Not needed: the demo wallet connects without WalletConnect.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
