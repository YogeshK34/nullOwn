# .env.example — copy to .env and fill in values; never commit .env

# ---------------------------------------------------------------------------
# Deployer (Hardhat / scripts only — never referenced by the frontend)
# ---------------------------------------------------------------------------
PRIVATE_KEY=                          # 0x... deployer wallet private key

# ---------------------------------------------------------------------------
# RPC endpoints
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=
MUMBAI_RPC_URL=

# ---------------------------------------------------------------------------
# Block explorer
# ---------------------------------------------------------------------------
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Deployed contract addresses (set after deployment, used by frontend)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ERC5564_ADDRESS=
NEXT_PUBLIC_ERC6538_ADDRESS=
NEXT_PUBLIC_VERIFIER_ADDRESS=
NEXT_PUBLIC_COMPLIANCE_ADDRESS=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111         # 11155111 = Sepolia, 80001 = Mumbai

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Runs the frontend with no chain behind it: contract addresses, block numbers,
# transaction hashes, the audit log, roles and the Groth16 proof bytes are all
# fabricated, and a mock wallet connects automatically. Everything
# cryptographic stays real. Set in frontend/.env.local, not here — it is a
# frontend-only switch and the Hardhat scripts ignore it.
#
# Any NEXT_PUBLIC_* value set explicitly still wins over the demo fallback.
NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Frontend extras
# ---------------------------------------------------------------------------
# WalletConnect Cloud project id — required by RainbowKit.
# Obtain one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Block height the announcement scanner starts from (contract deployment block).
# Scanning from 0 on a public testnet will be rejected by most RPC providers.
NEXT_PUBLIC_ANNOUNCEMENT_START_BLOCK=0

# Optional: public RPC override used for read-only calls / event scanning.
NEXT_PUBLIC_RPC_URL=
